{
  "expo": {
    "name": "Buy it!",
    "slug": "buy-it",
    "version": "1.0.0",
    "scheme": "buyit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ryuhosoy.buyit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ryuhosoy.buyit",
      "adaptiveIcon": {
        "backgroundColor": "#FF6B3D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "棚の写真を選ぶために写真ライブラリへのアクセスを使用します。",
          "cameraPermission": "棚を撮影するためにカメラへのアクセスを使用します。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "baa55a6f-ce9c-493a-9ccf-10aae8cabb3b"
      }
    },
    "owner": "ryuhosoy"
  }
}
