{
  "expo": {
    "name": "Buy it!",
    "slug": "buy-it",
    "version": "1.0.0",
    "scheme": "buyit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ryuhosoy.buyit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ryuhosoy.buyit",
      "adaptiveIcon": {
        "backgroundColor": "#FF6B3D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Buy it! uses your photo library to choose a shelf photo. / 棚の写真を選ぶために写真ライブラリへのアクセスを使用します。",
          "cameraPermission": "Buy it! uses the camera to photograph store shelves. / 棚を撮影するためにカメラへのアクセスを使用します。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "ryuhosoy",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8568be4-404f-4f21-8843-acc4e5808bf6"
      }
    }
  }
}
