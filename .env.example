# Anthropic (Claude) API キー。 https://console.anthropic.com/ で発行できます。
# EXPO_PUBLIC_ プレフィックスの変数はアプリのビルドに埋め込まれ、
# アプリを持つ人なら誰でも取り出せる状態になります（プロトタイプ向けの割り切り）。
# 本番運用では必ずサーバー経由のプロキシに置き換えてください。
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 省略可。使用するモデルを変更したい場合のみ指定（デフォルト: claude-sonnet-5）
# EXPO_PUBLIC_ANTHROPIC_MODEL=claude-opus-5

# RevenueCat（課金）。https://app.revenuecat.com/ の Project → API Keys から取得。
# Entitlement ID は `premium`（lib/constants/subscription.ts）に合わせること。
# 課金テストには Expo Go ではなく development / production ビルドが必要です。
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
